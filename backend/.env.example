# PostgreSQL connection (must have the pgvector extension available)
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=researchmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=researchmind

# Embedding model (sentence-transformers). Must match VECTOR_DIM below.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
VECTOR_DIM=768

# Reranker model (cross-encoder)
RERANKER_MODEL=BAAI/bge-reranker-base

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
VECTOR_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=15
RERANK_TOP_K=5
RRF_K=60

# Device: "cpu" or "cuda"
DEVICE=cpu
GEMINI_API_KEY=AIzaSyAB62FEOsEmFhooNRJipBLCPQwpvXvpU2k
GEMINI_MODEL=gemini-2.5-flash